<Window x:Class="LabMediaWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="LabMedia Widget" Height="40" Width="280"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" ResizeMode="NoResize"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">
    
    <Window.Resources>
        <ContextMenu x:Key="WidgetContextMenu">
            <MenuItem Header="Copy Track Title" Click="MenuItem_CopyTitle_Click" />
            <MenuItem Header="Copy Artist – Title" Click="MenuItem_CopyArtistTitle_Click" />
            <Separator />
            <MenuItem Header="Hide LabMedia" Click="MenuItem_Hide_Click" />
            <MenuItem Header="Open LabMedia Settings" Click="MenuItem_OpenSettings_Click" />
        </ContextMenu>

        <Style x:Key="MediaIconButton" TargetType="Button">
            <Setter Property="Width" Value="25" />
            <Setter Property="Height" Value="25" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="#d7dde5" />
            <Setter Property="Background" Value="#18ffffff" />
            <Setter Property="BorderBrush" Value="#20ffffff" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#2cffffff" />
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#38ffffff" />
                                <Setter Property="Foreground" Value="#ffffff" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryMediaIconButton" TargetType="Button" BasedOn="{StaticResource MediaIconButton}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="Background" Value="#1db954" />
            <Setter Property="BorderBrush" Value="#1db954" />
        </Style>
    </Window.Resources>

    <Border x:Name="MainBorder" Height="40" Padding="6,3" Background="#CC111318" BorderBrush="#30ffffff" BorderThickness="1" CornerRadius="8"
            ContextMenu="{StaticResource WidgetContextMenu}" MouseEnter="MainBorder_MouseEnter" MouseLeave="MainBorder_MouseLeave">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" x:Name="ColAlbumArt" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" x:Name="ColControls" />
            </Grid.ColumnDefinitions>
            <!-- Album Art -->
            <Border Grid.Column="0" x:Name="ArtContainer" Width="32" Height="32" CornerRadius="5" ClipToBounds="True" Margin="0,0,8,0" Cursor="Hand"
                    ToolTip="Open Now Playing" MouseLeftButtonDown="Art_MouseLeftButtonDown"
                    automation:AutomationProperties.Name="Open Now Playing panel">
                <Grid Background="#20ffffff">
                    <Image x:Name="ImgAlbumArt" Stretch="UniformToFill" />
                    <Path x:Name="TxtFallbackArt" Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 C 22,6.48 17.52,2 12,2 Z M 12,16.5 C 9.51,16.5 7.5,14.49 7.5,12 C 7.5,9.51 9.51,7.5 12,7.5 C 14.49,7.5 16.5,9.51 16.5,12 C 16.5,14.49 14.49,16.5 12,16.5 Z M 12,10.5 C 11.17,10.5 10.5,11.17 10.5,12 C 10.5,12.83 11.17,13.5 12,13.5 C 12.83,13.5 13.5,12.83 13.5,12 C 13.5,11.17 12.83,10.5 12,10.5 Z" Fill="#1db954" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Track Info -->
            <StackPanel x:Name="TrackInfoPanel" Grid.Column="1" VerticalAlignment="Center" Cursor="Hand"
                        ToolTip="Open Now Playing" MouseLeftButtonDown="TrackInfo_MouseLeftButtonDown"
                        automation:AutomationProperties.Name="Open track details in Now Playing panel">
                <TextBlock x:Name="TxtTitle" Text="No Track Playing" FontSize="11" FontWeight="Bold" Foreground="#f8fafc" TextTrimming="CharacterEllipsis" MaxWidth="140" />
                <TextBlock x:Name="TxtArtist" Text="Spotify" FontSize="9.5" Foreground="#8899aa" TextTrimming="CharacterEllipsis" MaxWidth="140" Margin="0,1,0,0" />
            </StackPanel>

            <!-- Media Control Buttons -->
            <StackPanel x:Name="ControlsRail" Grid.Column="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,0,2,0">
                <Button x:Name="BtnPrev" Style="{StaticResource MediaIconButton}" Margin="0,0,3,0" Click="BtnPrev_Click" Cursor="Hand" ToolTip="Previous"
                        automation:AutomationProperties.Name="Previous track">
                    <Path Data="M 15,5 L 8,12 L 15,19"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="8" Height="13" Stretch="Uniform" />
                </Button>
                <Button x:Name="BtnPlayPause" Style="{StaticResource PrimaryMediaIconButton}" Margin="0,0,3,0" Click="BtnPlayPause_Click" Cursor="Hand" ToolTip="Play or pause"
                        automation:AutomationProperties.Name="Play or pause">
                    <Path x:Name="PathPlayPause" Data="M 7,5 L 18,12 L 7,19 Z"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Width="11" Height="12" Stretch="Uniform" />
                </Button>
                <Button x:Name="BtnNext" Style="{StaticResource MediaIconButton}" Click="BtnNext_Click" Cursor="Hand" ToolTip="Next" Margin="0,0,3,0"
                        automation:AutomationProperties.Name="Next track">
                    <Path Data="M 9,5 L 16,12 L 9,19"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="8" Height="13" Stretch="Uniform" />
                </Button>
            </StackPanel>

            <!-- Volume Level Overlay Toast -->
            <Border x:Name="VolToastBorder" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0" Background="#EE111318" BorderBrush="#38bdf8" BorderThickness="1" CornerRadius="9" Padding="8,2" Panel.ZIndex="10" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path x:Name="PathVolToastIcon" Data="M 3,9 V 15 H 7 L 12,20 V 4 L 7,9 H 3 Z M 16.5,12 C 16.5,10.23 15.48,8.71 14,7.97 V 16.02 C 15.48,15.29 16.5,13.77 16.5,12 Z M 14,3.23 V 5.29 C 16.89,6.15 19,8.83 19,12 C 19,15.17 16.89,17.85 14,18.71 V 20.77 C 18.01,19.86 21,16.28 21,12 C 21,7.72 18.01,4.14 14,3.23 Z" Fill="#38bdf8" Width="10" Height="10" Stretch="Uniform" Margin="0,0,5,0"/>
                    <TextBlock x:Name="TxtVolToast" Text="75%" FontSize="9.5" FontWeight="Bold" Foreground="#ffffff" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Progress Bar with Accent Glow -->
            <ProgressBar Grid.Column="0" Grid.ColumnSpan="3" Panel.ZIndex="5" x:Name="ProgressTrack" Height="3" VerticalAlignment="Bottom" Background="#20ffffff" Foreground="#1db954" BorderThickness="0" Minimum="0" Maximum="100" Value="0" Cursor="Hand" MouseLeftButtonDown="ProgressTrack_MouseLeftButtonDown"
                         automation:AutomationProperties.Name="Playback position">
                <ProgressBar.Effect>
                    <DropShadowEffect x:Name="ProgressGlow" Color="#1db954" BlurRadius="6" ShadowDepth="0" Opacity="0.6" />
                </ProgressBar.Effect>
            </ProgressBar>
        </Grid>
    </Border>
</Window>
