<Window x:Class="LabMediaWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LabMedia Widget" Height="40" Width="280"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" ResizeMode="NoResize">
    
    <Window.Resources>
        <ContextMenu x:Key="WidgetContextMenu">
            <MenuItem Header="Hide LabMedia" Click="MenuItem_Hide_Click" />
            <Separator />
            <MenuItem Header="Open LabMedia Settings" Click="MenuItem_OpenSettings_Click" />
        </ContextMenu>

        <Style x:Key="MediaIconButton" TargetType="Button">
            <Setter Property="Width" Value="25" />
            <Setter Property="Height" Value="25" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="#46515c" />
            <Setter Property="Background" Value="#eaf7ff" />
            <Setter Property="BorderBrush" Value="#73c9ff" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#38bdf8" BlurRadius="4" ShadowDepth="0" Opacity="0.34" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#ffffff" />
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#9bddff" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#c9edff" />
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryMediaIconButton" TargetType="Button" BasedOn="{StaticResource MediaIconButton}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="Background" Value="#1db954" />
            <Setter Property="BorderBrush" Value="#69e596" />
        </Style>
    </Window.Resources>

    <Border x:Name="MainBorder" Height="40" Padding="6,3" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" ContextMenu="{StaticResource WidgetContextMenu}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" x:Name="ColAlbumArt" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" x:Name="ColControls" />
            </Grid.ColumnDefinitions>
            <!-- Album Art -->
            <Border Grid.Column="0" x:Name="ArtContainer" Width="32" Height="32" CornerRadius="4" ClipToBounds="True" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonDown="Art_MouseLeftButtonDown">
                <Grid Background="#20ffffff">
                    <Image x:Name="ImgAlbumArt" Stretch="UniformToFill" />
                    <Path x:Name="TxtFallbackArt" Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 C 22,6.48 17.52,2 12,2 Z M 12,16.5 C 9.51,16.5 7.5,14.49 7.5,12 C 7.5,9.51 9.51,7.5 12,7.5 C 14.49,7.5 16.5,9.51 16.5,12 C 16.5,14.49 14.49,16.5 12,16.5 Z M 12,10.5 C 11.17,10.5 10.5,11.17 10.5,12 C 10.5,12.83 11.17,13.5 12,13.5 C 12.83,13.5 13.5,12.83 13.5,12 C 13.5,11.17 12.83,10.5 12,10.5 Z" Fill="#1db954" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Track Info -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="TrackInfo_MouseLeftButtonDown">
                <TextBlock x:Name="TxtTitle" Text="No Track Playing" FontSize="11" FontWeight="Bold" Foreground="#f8fafc" TextTrimming="CharacterEllipsis" MaxWidth="140" />
                <TextBlock x:Name="TxtArtist" Text="Spotify" FontSize="9.5" Foreground="#94a3b8" TextTrimming="CharacterEllipsis" MaxWidth="140" Margin="0,1,0,0" />
            </StackPanel>

            <!-- Media Control Buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,2,0">
                <Button x:Name="BtnPrev" Style="{StaticResource MediaIconButton}" Margin="0,0,3,0" Click="BtnPrev_Click" Cursor="Hand" ToolTip="Previous">
                    <Path Data="M 15,5 L 8,12 L 15,19"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="8" Height="13" Stretch="Uniform" />
                </Button>
                <Button x:Name="BtnPlayPause" Style="{StaticResource PrimaryMediaIconButton}" Margin="0,0,3,0" Click="BtnPlayPause_Click" Cursor="Hand" ToolTip="Play or pause">
                    <Path x:Name="PathPlayPause" Data="M 7,5 L 18,12 L 7,19 Z"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Width="11" Height="12" Stretch="Uniform" />
                </Button>
                <Button x:Name="BtnNext" Style="{StaticResource MediaIconButton}" Click="BtnNext_Click" Cursor="Hand" ToolTip="Next">
                    <Path Data="M 9,5 L 16,12 L 9,19"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="8" Height="13" Stretch="Uniform" />
                </Button>
            </StackPanel>

            <!-- Progress Bar -->
            <ProgressBar Grid.Column="0" Grid.ColumnSpan="3" Panel.ZIndex="5" x:Name="ProgressTrack" Height="3" VerticalAlignment="Bottom" Background="#20ffffff" Foreground="#1db954" BorderThickness="0" Minimum="0" Maximum="100" Value="0" Cursor="Hand" MouseLeftButtonDown="ProgressTrack_MouseLeftButtonDown" />
        </Grid>
    </Border>
</Window>
